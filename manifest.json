{
  "manifest_version": 3,
  "name": "Sweep — Bulk Delete Email by Sender for Gmail",
  "version": "1.0.0",
  "description": "Delete every email from one sender in two clicks. Free and open source, no sign-in, no inbox access, zero network requests.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
