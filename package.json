{
  "name": "sweep-for-gmail",
  "version": "1.0.0",
  "private": true,
  "description": "Delete every email from one sender in Gmail, in two clicks.",
  "homepage": "https://pekhota.github.io/sweep-for-gmail/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pekhota/sweep-for-gmail.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "syntax": "node --check content.js",
    "validate": "node tools/validate.mjs",
    "package": "./tools/package.sh",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run syntax && npm run validate",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
